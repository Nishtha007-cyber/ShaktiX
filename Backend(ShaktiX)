<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#111111"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:gravity="center"
        android:padding="24dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Contact Name Input -->
        <EditText
            android:id="@+id/contactNameInput"
            android:hint="Enter Contact Name"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Contact Number Input -->
        <EditText
            android:id="@+id/contactNumberInput"
            android:hint="Enter Contact Number"
            android:inputType="phone"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Save Contact Button -->
        <Button
            android:id="@+id/saveContactButton"
            android:text="SAVE CONTACT"
            android:layout_marginTop="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Emergency Contact Display -->
        <TextView
            android:id="@+id/contactText"
            android:text="Emergency Contact: None"
            android:textColor="#FFFFFF"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- SOS Instruction -->
        <TextView
            android:id="@+id/statusText"
            android:text="SHAKE PHONE TO ACTIVATE SOS"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Location Display -->
        <TextView
            android:id="@+id/locationText"
            android:textColor="#FF4444"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Cancel SOS Button -->
        <Button
            android:id="@+id/cancelButton"
            android:text="CANCEL SOS"
            android:layout_marginTop="30dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>
